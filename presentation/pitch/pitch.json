  "segments": [
    {
      "id": "s01-proof",
      "start_s": 0.2,
      "end_s": 8.819,
      "duration_s": 8.619,
      "caption": "On NEAR mainnet, a signed order was rejected 67 s before it expired, because the owner had already revoked its key."
    },
    {
      "id": "s02-name",
      "start_s": 9.099,
      "end_s": 15.328,
      "duration_s": 6.229,
      "caption": "Bounded Mandate: give an AI agent trading authority without unrestricted control of your treasury."
    },
    {
      "id": "s03-problem",
      "start_s": 15.608,
      "end_s": 21.667,
      "duration_s": 6.059,
      "caption": "Pausing an agent stops new orders, but does not itself invalidate orders already signed."
    },
    {
      "id": "s04-agent",
      "start_s": 21.947,
      "end_s": 27.216,
      "duration_s": 5.269,
      "caption": "The agent cannot sign Intents orders. Its key can only request a proposal."
    },
    {
      "id": "s05-contract",
      "start_s": 27.496,
      "end_s": 36.179,
      "duration_s": 8.683,
      "caption": "A NEAR contract prices each order from the oracle, checks your limits, then asks NEAR's MPC network to sign it (Chain Signatures)."
    },
    {
      "id": "s06-verifier",
      "start_s": 36.459,
      "end_s": 42.731,
      "duration_s": 6.272,
      "caption": "The NEAR Intents verifier checks that key on every order, so revoking is one owner call that removes it."
    },
    {
      "id": "s07-run",
      "start_s": 43.011,
      "end_s": 52.227,
      "duration_s": 9.216,
      "caption": "Mainnet, fixed proposals, our own filler: an over-limit order refused; a 1 USDC order signed and filled."
    },
    {
      "id": "s08-revoke",
      "start_s": 52.507,
      "end_s": 57.84,
      "duration_s": 5.333,
      "caption": "A second signed order was held back. The owner revoked; removal of the key was confirmed."
    },
    {
      "id": "s09-reject",
      "start_s": 58.12,
      "end_s": 63.133,
      "duration_s": 5.013,
      "caption": "The held order was relayed and rejected: its signing key no longer exists."
    },
    {
      "id": "s10-recover",
      "start_s": 63.413,
      "end_s": 66.912,
      "duration_s": 3.499,
      "caption": "Recovery returned both assets to the owner's Intents account."
    },
    {
      "id": "s11-sandbox",
      "start_s": 67.192,
      "end_s": 74.189,
      "duration_s": 6.997,
      "caption": "Sandbox, labelled test doubles: 39 scripted hostile requests refused across five layers."
    },
    {
      "id": "s12-limits",
      "start_s": 74.469,
      "end_s": 81.957,
      "duration_s": 7.488,
      "caption": "Orders executed before confirmed removal stay executed. Not an audit; no profit promised."
    },
    {
      "id": "s13-verify",
      "start_s": 82.237,
      "end_s": 87.549,
      "duration_s": 5.312,
      "caption": "Check the mainnet proof against the chain: node verify.mjs --mainnet (make verify is the offline file check). Start at the overview page."
    }
  ],
